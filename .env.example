# Copie para .env. Valores só para desenvolvimento local, com dados fictícios.

# Usuário dono do banco: cria as tabelas e roda o seed.
POSTGRES_USER=kpi
POSTGRES_PASSWORD=kpi_dev
POSTGRES_DB=callcenter
POSTGRES_PORT=5433

# Usuário só de leitura que o servidor MCP usa. Criado pelo db/init/02-readonly-role.sh.
MCP_DB_USER=mcp_leitura
MCP_DB_PASSWORD=leitura_dev

# Conexões usadas fora do Docker (npm run seed / npm run dev).
SEED_DATABASE_URL=postgres://kpi:kpi_dev@localhost:5433/callcenter
DATABASE_URL=postgres://mcp_leitura:leitura_dev@localhost:5433/callcenter

# Seed: mesma semente, mesmos dados. A data final padrão é ontem (fuso de São Paulo).
SEED=42
SEED_DIAS=90
# SEED_DATA_FIM=2026-11-13

# Limites do servidor
MAX_LINHAS=100
STATEMENT_TIMEOUT_MS=5000
